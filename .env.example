# Copy to .env at the repository root. Never commit real credentials.
DB_SERVER=sql-server.internal,1433
DB_DATABASE=SmartTOS
DB_USERNAME=dashboard_reader
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=20
DB_ENCRYPT=true
# Prefer a trusted SQL Server certificate. Temporary local exception only:
DB_TRUST_SERVER_CERTIFICATE=false
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=https://dashboard-sanluong.vercel.app
# Additional exact origins, encoded as a JSON array.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# ControlStore reads this from the PROCESS environment (or Railway Variables).
# This .env line is reference only; copying it here does not export it to the process.
# Default: the creator and every editor of a plan version cannot approve it, including admins.
DASHBOARD_PLAN_APPROVAL_POLICY=separate_approver
# Legacy compatibility override, only when intentionally restoring the old self-approval policy:
# DASHBOARD_PLAN_APPROVAL_POLICY=allow_self
