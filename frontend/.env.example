# Development server proxy target (origin only, without /api).
# The previous VITE_API_PROXY_TARGET name remains supported.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# Leave unset to use the same-origin /api path (recommended).
# VITE_API_URL=https://report.example/api
# Local frontend + Railway API: see ../docs/LOCAL_RAILWAY.vi.md.
# Never put SQL credentials or other secrets in VITE_* variables.
